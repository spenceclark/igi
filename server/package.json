{
  "name": "igi-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker start igi-postgres || docker run -d --name igi-postgres -p 5434:5432 -e POSTGRES_USER=igi -e POSTGRES_PASSWORD=igi -e POSTGRES_DB=igi -v igi-pgdata:/var/lib/postgresql postgres:18",
    "smoke:monty": "node scripts/monty-smoke.ts",
    "probe:meta": "node --env-file-if-exists=.env scripts/meta-probe.ts",
    "probe:cairn": "node --env-file-if-exists=.env scripts/cairn-probe.ts",
    "start": "node --env-file-if-exists=.env scripts/serve.ts",
    "cairn": "node --env-file-if-exists=.env scripts/cairn-run.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "investigate": "node --env-file-if-exists=.env scripts/investigate.ts"
  },
  "dependencies": {
    "@pydantic/monty": "1.4.0",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "puppeteer": "25.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  }
}
